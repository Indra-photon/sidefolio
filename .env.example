# ImageKit (media storage / video optimization)
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# MongoDB (blogs, categories, craft videos)
MONGODB_URI=

# Resend (contact form email)
RESEND_API_KEY=

# TinyMCE (admin blog editor)
NEXT_PUBLIC_TINYMCE_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blog media — Cloudflare R2 (see docs/media-guide.md)
NEXT_PUBLIC_MEDIA_URL=                # public bucket URL, e.g. https://pub-xxxx.r2.dev or https://media.yourdomain.com
R2_ACCOUNT_ID=                          # upload script only
R2_ACCESS_KEY_ID=                       # upload script only (R2 API token)
R2_SECRET_ACCESS_KEY=                   # upload script only
R2_BUCKET=                              # upload script only
# Optional — Cloudflare Stream, only for long videos with sound (<Video id="…" />)
NEXT_PUBLIC_CF_STREAM_CUSTOMER=
